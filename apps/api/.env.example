# Pooler host (hostname contains -pooler). Used by the API, worker, and pg-boss.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct host (same URL with -pooler removed). Used only by the Prisma CLI.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

NODE_ENV="development"
PORT=3000
LOG_LEVEL="info"
CORS_ORIGINS="http://localhost:5173"
WORKER_ENABLED="false"

# general consumes discovery queues. browser stays idle until audit plugins register.
# WORKER_ROLE="general"

# Required. At least 32 characters. Generate a unique value per environment.
BETTER_AUTH_SECRET="replace-with-a-random-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Optional in development. When empty, discovery returns a sample set.
# Required in production.
OUTSCRAPER_API_KEY=""
