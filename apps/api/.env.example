# Pooler host (hostname contains -pooler). Used by the API, worker, and pg-boss.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct host (same URL with -pooler removed). Used only by the Prisma CLI.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

APIFY_TOKEN=""
APIFY_ACTOR="scraperlink/google-maps-scraper"

NODE_ENV="development"
PORT=3000
LOG_LEVEL="info"
CORS_ORIGINS="http://localhost:5173"
WORKER_ENABLED="false"

# Required. At least 32 characters. Generate a unique value per environment.
BETTER_AUTH_SECRET="replace-with-a-random-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Discovery API keys (Apify is preferred; fallback to Outscraper, SerpAPI, or Google Places)
APIFY_TOKEN=""
APIFY_ACTOR="scraperlink/google-maps-scraper"
OUTSCRAPER_API_KEY=""
SERPAPI_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# Queue. Local development uses pg-boss. Production Cloud Run uses pubsub.
QUEUE_DRIVER="pgboss"
GCP_PROJECT_ID=""
PUBSUB_PUSH_AUDIENCE=""
PUBSUB_PUSH_SERVICE_ACCOUNT=""
GCS_BUCKET=""
PAGESPEED_API_KEY=""
DB_POOL_MAX="2"

# Email & App URL
RESEND_API_KEY=""
EMAIL_FROM="Rove <onboarding@resend.dev>"
APP_WEB_URL="http://localhost:5173"

# Default super admin credentials created automatically on server boot if not existing
SUPERADMIN_EMAIL="admin@rove.local"
SUPERADMIN_PASSWORD="supersecretpassword123"
SUPERADMIN_NAME="Super Admin"
