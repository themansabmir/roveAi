{
  "name": "rove",
  "version": "0.1.0",
  "private": true,
  "description": "Rove monorepo — automated opportunity engine for local businesses",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "dev:web": "turbo run dev --filter=@rove/web",
    "dev:studio": "turbo run dev --filter=@rove/studio",
    "dev:agency-web": "turbo run dev --filter=@rove/agency-web",
    "dev:dashboard": "turbo run dev --filter=@rove/dashboard",
    "dev:api": "turbo run dev --filter=@rove/api"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
