# =============================================================================
# RoVe AI — Docker Environment Variables Configuration
# Copy this file to .env before running: docker compose up --build -d
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Remote Neon DB PostgreSQL)
# -----------------------------------------------------------------------------
# Neon pooled connection string (with -pooler in hostname) used by API, workers, and pg-boss
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection string (unpooled direct host) used by Prisma CLI migrations
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# CORS origins allowed to access the API (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# Frontend Dashboard base URL
APP_WEB_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# Generate a random string of at least 32 characters (e.g., `openssl rand -base64 32`)
BETTER_AUTH_SECRET="replace-with-a-random-secret-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Default Superadmin Credentials (Created automatically on first boot)
# -----------------------------------------------------------------------------
SUPERADMIN_EMAIL=admin@rove.local
SUPERADMIN_PASSWORD=supersecretpassword123
SUPERADMIN_NAME="Super Admin"

# -----------------------------------------------------------------------------
# Queue Configuration
# -----------------------------------------------------------------------------
# "pgboss" for local development over Neon DB; "pubsub" for GCP Cloud Run
QUEUE_DRIVER="pgboss"
WORKER_CONCURRENCY=2
WORKER_RETRY_LIMIT=2
JOB_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Object Storage (Local development uses shared Docker volume; GCS for GCP)
# -----------------------------------------------------------------------------
# Leave unset in local development to use local disk storage in Docker volume
# GCS_BUCKET=""
# GCP_PROJECT_ID=""

# -----------------------------------------------------------------------------
# External APIs & Scraping Providers
# -----------------------------------------------------------------------------
# Google PageSpeed Insights API Key
PAGESPEED_API_KEY=""

# Apify Google Maps Scraper (optional in development; uses mock sample if empty)
APIFY_TOKEN=""
APIFY_ACTOR="scraperlink/google-maps-scraper"

# Outscraper / SerpApi / Google Places (optional)
OUTSCRAPER_API_KEY=""
SERPAPI_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# -----------------------------------------------------------------------------
# AI Reasoning & LLM Providers (Gemini / OpenAI / Anthropic)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_MODEL="gemini-3.8-flash"
LLM_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Email Provider (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Rove <onboarding@resend.dev>"

